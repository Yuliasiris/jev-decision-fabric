import test from 'node:test';
import assert from 'node:assert/strict';
import { mcp, rest, health, validateInput, validateAnswers, evaluate, sha, PROTOCOL } from '../netlify/lib/gateway.mts';
import { QUESTION_SETS } from '../netlify/lib/questions.mts';

const values: Record<string,string>={JEV_GATEWAY_TOKEN:'test-only-'+('x'.repeat(40)),REST_LIVE_ENABLED:'true',MCP_LIVE_ENABLED:'true',JEV_PROVIDER_MODE:'typesafe-direct',TYPESAFE_API_KEY:'TEST_FAKE_KEY',TYPESAFE_BASE_URL:'https://api.typesafe.ai'};
const env=(k:string)=>values[k];
const none=(_k:string)=>undefined;
const rpc=(method:string,params:unknown={},id:unknown=1)=>new Request('https://example.netlify.app/mcp',{method:'POST',headers:{'content-type':'application/json',accept:'application/json, text/event-stream'},body:JSON.stringify({jsonrpc:'2.0',id,method,params})});
const input={question_set:'synthetic-smoke-v0',state:{status:'closed',next_work_ready:true}};
const req=(body:unknown=input,token=values.JEV_GATEWAY_TOKEN)=>new Request('https://example.netlify.app/v1/decision',{method:'POST',headers:{'content-type':'application/json',authorization:`Bearer ${token}`},body:JSON.stringify(body)});
const forbidden=(async()=>{throw new Error('UNEXPECTED_NETWORK')}) as typeof fetch;
const validResponse=()=>Response.json({model:'jev-test',answers:{should_continue:{noul:0.7}},usage:{input_tokens:20}});

test('16 original question slots and a separate smoke set',()=>{assert.equal(Object.keys(QUESTION_SETS['ops-liveness-v0']).length,16);assert.ok(QUESTION_SETS['synthetic-smoke-v0']);});
test('valid request is retained',()=>assert.deepEqual(validateInput(input),input));
for(const state of [null,undefined,true,2]) test(`invalid state ${state}`,()=>assert.throws(()=>validateInput({question_set:'synthetic-smoke-v0',state})));
for(const question_set of ['__proto__','constructor','not-a-set']) test(`reject unknown set ${question_set}`,()=>assert.throws(()=>validateInput({...input,question_set})));
test('reject free model injection',()=>assert.throws(()=>validateInput({...input,model:'anything'})));
test('reject oversized state',()=>assert.throws(()=>validateInput({...input,state:'x'.repeat(128*1024+1)})));
test('hash independent of object key ordering',()=>assert.equal(sha({a:1,b:2}),sha({b:2,a:1})));
test('hash binds exact state',()=>assert.notEqual(sha({a:1}),sha({a:2})));
test('MCP initialize works without key',async()=>{const r=await mcp(rpc('initialize'),none,forbidden);assert.equal(r.status,200);assert.equal((await r.json()).result.protocolVersion,PROTOCOL);});
test('MCP discovery has accurate annotations',async()=>{const d=await (await mcp(rpc('tools/list'),none,forbidden)).json();assert.equal(d.result.tools.length,1);assert.equal(d.result.tools[0].annotations.openWorldHint,true);assert.equal(d.result.tools[0].annotations.idempotentHint,false);});
test('MCP live disabled cannot call provider',async()=>{const d=await (await mcp(rpc('tools/call',{name:'decision_evaluate',arguments:input}),none,forbidden)).json();assert.equal(d.result.isError,true);});
test('MCP live switch does not bypass auth',async()=>{const r=await mcp(rpc('tools/call',{name:'decision_evaluate',arguments:input}),env,forbidden);assert.equal(r.status,401);});
test('MCP invalid origin is rejected',async()=>{const r=rpc('tools/list');r.headers.set('origin','https://untrusted.example');assert.equal((await mcp(r,none,forbidden)).status,403);});
test('MCP GET does not open an SSE job',async()=>assert.equal((await mcp(new Request('https://example.netlify.app/mcp'),none,forbidden)).status,405));
test('MCP initialized notification is 202 empty',async()=>{const r=new Request('https://example.netlify.app/mcp',{method:'POST',headers:{'content-type':'application/json',accept:'application/json, text/event-stream'},body:JSON.stringify({jsonrpc:'2.0',method:'notifications/initialized'})});const out=await mcp(r,none,forbidden);assert.equal(out.status,202);assert.equal(await out.text(),'');});
test('MCP JSON-RPC batch rejected',async()=>{const r=new Request('https://example.netlify.app/mcp',{method:'POST',headers:{'content-type':'application/json',accept:'application/json, text/event-stream'},body:'[]'});assert.equal((await mcp(r,none,forbidden)).status,400);});
test('MCP unknown tool rejected',async()=>{const d=await (await mcp(rpc('tools/call',{name:'execute'}),none,forbidden)).json();assert.equal(d.error.code,-32602);});
test('MCP requires Accept headers',async()=>{const r=rpc('tools/list');r.headers.delete('accept');assert.equal((await mcp(r,none,forbidden)).status,406);});
test('REST no config fails closed',async()=>assert.equal((await rest(req(),none,forbidden)).status,503));
test('REST invalid bearer blocked',async()=>assert.equal((await rest(req(input,'wrong'),env,forbidden)).status,401));
test('REST live disabled blocked',async()=>assert.equal((await rest(req(),k=>k==='REST_LIVE_ENABLED'?'false':env(k),forbidden)).status,503));
test('REST invalid JSON is sanitized',async()=>{const r=req();const bad=new Request(r.url,{method:'POST',headers:r.headers,body:'{' });const out=await rest(bad,env,forbidden);assert.equal(out.status,400);assert.equal((await out.json()).error,'INVALID_JSON');});
test('oversized HTTP body blocked before provider',async()=>assert.equal((await rest(req({...input,state:'x'.repeat(170*1024)}),env,forbidden)).status,413));
test('does not silently use Netlify AI Gateway credits',async()=>await assert.rejects(()=>evaluate(input,k=>k==='JEV_PROVIDER_MODE'?undefined:env(k),forbidden)));
test('direct mode rejects injected proxy base',async()=>await assert.rejects(()=>evaluate(input,k=>k==='TYPESAFE_BASE_URL'?'https://proxy.invalid':env(k),forbidden)));
test('mock REST result includes state/question bindings',async()=>{let calls=0;const send=(async(url:any,init:any)=>{calls++;assert.equal(url,'https://api.typesafe.ai/v1/systemone');assert.equal(init.headers.authorization,'Bearer TEST_FAKE_KEY');assert.equal(init.redirect,'error');return validResponse()}) as typeof fetch;const out=await rest(req(),env,send);assert.equal(out.status,200);const r=await out.json();assert.equal(r.resolved_model,'jev-test');assert.equal(r.state_sha256,sha(input.state));assert.equal(r.question_set_sha256,sha(QUESTION_SETS[input.question_set]));assert.equal(r.automatic_apply,false);assert.equal(calls,1);assert.ok(!JSON.stringify(r).includes('TEST_FAKE_KEY'));});
test('mock authenticated MCP call',async()=>{const r=rpc('tools/call',{name:'decision_evaluate',arguments:input});r.headers.set('authorization','Bearer '+values.JEV_GATEWAY_TOKEN);const out=await mcp(r,env,(async()=>validResponse()) as typeof fetch);assert.equal((await out.json()).result.structuredContent.answers.should_continue.noul,0.7);});
for(const status of [401,429,500])test(`provider ${status} has no auto retry or raw error leakage`,async()=>{let calls=0;const r=await rest(req(),env,(async()=>{calls++;return new Response('TEST_FAKE_KEY private provider error',{status});}) as typeof fetch);assert.equal(calls,1);assert.ok(!((await r.text()).includes('TEST_FAKE_KEY')));});
test('network error sanitized',async()=>{const r=await rest(req(),env,(async()=>{throw new Error('TEST_FAKE_KEY')}) as typeof fetch);assert.equal(r.status,504);assert.ok(!(await r.text()).includes('TEST_FAKE_KEY'));});
test('provider malformed response rejected',async()=>{const r=await rest(req(),env,(async()=>Response.json({answers:{should_continue:{noul:5}}})) as typeof fetch);assert.equal(r.status,502);});
test('unexpected answer key rejected',()=>assert.throws(()=>validateAnswers({answers:{should_continue:{noul:.8},extra:{}}},QUESTION_SETS['synthetic-smoke-v0'])));
test('invalid choice distribution rejected',()=>assert.throws(()=>validateAnswers({answers:{Q01:{choice:'scope_closed',confidence:1,probabilities:{scope_closed:1}}}},{Q01:QUESTION_SETS['ops-liveness-v0'].Q01})));
test('health is explicit about incomplete auth and no keys',async()=>{const out=await health(new Request('https://example.netlify.app/health'),env).json();assert.equal(out.chatgpt_oauth,'not_implemented');assert.ok(!JSON.stringify(out).includes('TEST_FAKE_KEY'));});
